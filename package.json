{
  "name": "obsidian-daymark",
  "version": "0.1.0",
  "description": "A local-first daily journal calendar with Tally summaries for Obsidian.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src tests vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node version-bump.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.0",
    "moment": "2.29.4",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
